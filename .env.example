# ==============================================================
# AcxiomCRM Environment Configuration
# ==============================================================

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# Frontend Client URL (used for CORS and cookies)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acxiomcrm?schema=public

# JWT Configuration
JWT_SECRET=acxiom_crm_super_secure_enterprise_secret_key_2026_change_in_production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
